rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'pinya1994@gmail.com',
        'consiguetualgogratis@gmail.com',
        'consiguetualgogratis@tuthor.app',
        'manel.willx@gmail.com'
      ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Capacidad de profesor activa sobre la propia cuenta (no es un rol
    // exclusivo: una cuenta puede seguir jugando como alumno).
    function isTeacher(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return request.auth != null && request.auth.uid == uid
        && 'teacherProfile' in u && u.teacherProfile.active == true;
    }

    // Profesor vinculado a este alumno (linkedTeacherIds vive en el propio
    // doc del alumno para que esto sea SIEMPRE una única lectura, sin
    // importar a cuántos profesores/clases esté vinculado).
    function isLinkedTeacher(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return request.auth != null
        && 'linkedTeacherIds' in u && request.auth.uid in u.linkedTeacherIds;
    }

    // Esta escritura activa teacherProfile.active por primera vez (no lo
    // toca si ya era true: reenviar el formulario o editar el centro/ciclo
    // no debe volver a pedir código).
    function becomesTeacher() {
      return 'teacherProfile' in request.resource.data
        && request.resource.data.teacherProfile.active == true
        && (resource == null || !('teacherProfile' in resource.data) || resource.data.teacherProfile.active != true);
    }

    // El código en sí nunca es legible por el cliente (promoCodes/{code}
    // está bloqueado más abajo): solo se comprueba que exista el doc con
    // ese id, vía exists(), que no está sujeto a las propias rules.
    function hasValidPromoCode() {
      return 'teacherProfile' in request.resource.data
        && request.resource.data.teacherProfile.promoCode is string
        && exists(/databases/$(database)/documents/promoCodes/$(request.resource.data.teacherProfile.promoCode));
    }

    // ── Perfil de usuario ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isOwner(uid) || isAdmin()
        || (request.auth != null && 'linkedTeacherIds' in resource.data && request.auth.uid in resource.data.linkedTeacherIds);
      allow write: if isOwner(uid) && (!becomesTeacher() || hasValidPromoCode());

      match /activity/{activityId} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      match /stats/{statId} {
        allow read:  if isOwner(uid) || isAdmin() || isLinkedTeacher(uid);
        allow write: if isOwner(uid);
      }
    }

    // ── Clases de profesor ────────────────────────────────────────────────────
    // classCodes/{code}: puente de solo-lookup "código legible → classId".
    // Lectura abierta a cualquier autenticado (no expone nada sensible: solo
    // un classId y el uid del profesor, ambos necesarios para unirse) porque
    // un alumno que aún no se ha unido no tiene permiso para leer /classes
    // directamente y necesita resolver el código primero.
    match /classCodes/{code} {
      allow read: if request.auth != null;
      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['classId', 'teacherId', 'createdAt'])
        && request.resource.data.classId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /classes/{classId} {
      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'code', 'studentIds', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.studentIds == []
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId)
        || (request.auth != null && request.auth.uid in resource.data.studentIds);

      allow update: if isAdmin()
        // Profesor: solo puede tocar name/updatedAt.
        || (request.auth != null && request.auth.uid == resource.data.teacherId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.studentIds == resource.data.studentIds
            && request.resource.data.updatedAt == request.time)
        // Alumno uniéndose: solo puede añadir su propio uid al final de
        // studentIds, nada más (arrayUnion se resuelve antes de evaluar esto).
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'updatedAt'])
            && request.resource.data.studentIds == resource.data.studentIds.concat([request.auth.uid])
            && request.resource.data.updatedAt == request.time);

      allow delete: if false;
    }

    // ── Códigos promocionales para activar la capacidad de profesor ───────────
    // Un doc por código (id = el código en sí, ej. promoCodes/TUTHOR-PROFES).
    // No se lee ni escribe nunca desde el cliente: solo lo consulta
    // hasValidPromoCode() con exists(), que no está sujeto a estas rules.
    // Añadir/quitar códigos es cosa de consola de Firebase, no de la app.
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // ── Tareas asignadas por el profesor (a la clase o a alumnos concretos) ────
    // studentIds es una foto fija de los destinatarios al crear la tarea.
    // completions es un mapa por alumno (completions.<uid>): el profesor puede
    // tocar cualquier campo (incluida la finalización manual de tareas de
    // texto libre); un alumno destinatario solo puede escribir SU propia
    // entrada dentro de completions (al completar un juego/examen asignado),
    // nunca el resto del documento ni la entrada de otro alumno.
    match /assignments/{taskId} {
      function classOwnedByCaller(classId) {
        return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }

      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && classOwnedByCaller(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['teacherId', 'classId', 'className', 'kind', 'gameId', 'title', 'studentIds', 'dueDate', 'createdAt', 'completions'])
        && request.resource.data.kind in ['catalog', 'text']
        && request.resource.data.studentIds is list && request.resource.data.studentIds.size() > 0
        && request.resource.data.completions == {}
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId)
        || (request.auth != null && request.auth.uid in resource.data.studentIds);

      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.createdAt == resource.data.createdAt)
        || (request.auth != null && request.auth.uid in resource.data.studentIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions'])
            && request.resource.data.completions.diff(resource.data.completions).affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if false;
    }

    // ── Contador global (solo admins leen, usuarios autenticados incrementan) ──
    match /_stats/global {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Leaderboards: una entrada por jugador ──────────────────────────────────
    // Lectura pública (rankings visibles sin sesión); cada usuario solo puede
    // escribir su propia entrada. Anti-cheat sin backend (sube el listón, no
    // lo elimina): solo los campos conocidos, score acotado y estrictamente
    // creciente, updatedAt de servidor y mínimo 15 s entre récords.
    // El cliente (updateLeaderboard en src/lib/activity.js) hace dos escrituras:
    // setDoc completo al batir récord y updateDoc solo-cosméticos al equipar.
    match /leaderboards/{game}/entries/{uid} {

      // Documento completo válido (récord nuevo, vía setDoc)
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'photoURL', 'score', 'updatedAt', 'avatarEmoji', 'bannerId', 'frameId'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 500))
          && d.score is number && d.score >= 0 && d.score <= 100000
          && d.updatedAt == request.time
          && (!('avatarEmoji' in d) || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('bannerId' in d) || (d.bannerId is string && d.bannerId.size() <= 40))
          && (!('frameId' in d) || (d.frameId is string && d.frameId.size() <= 40));
      }

      // Sync de cosméticos (updateDoc): no toca ni score ni updatedAt
      function cosmeticOnlyUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['avatarEmoji', 'bannerId', 'frameId'])
          && (!('avatarEmoji' in d) || d.avatarEmoji == null || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('bannerId' in d) || (d.bannerId is string && d.bannerId.size() <= 40))
          && (!('frameId' in d) || (d.frameId is string && d.frameId.size() <= 40));
      }

      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid) && (
        (validEntry()
          && request.resource.data.score > resource.data.score
          && (!('updatedAt' in resource.data)
            || request.time > resource.data.updatedAt + duration.value(15, 's')))
        || cosmeticOnlyUpdate()
      );
      allow delete: if false;
    }

    // ── Leaderboards legacy (_stats/leaderboard_*): solo lectura ──────────────
    // Congelados como fallback de lectura hasta que la subcolección se llene.
    match /_stats/{leaderboardId} {
      allow read: if leaderboardId.matches('leaderboard_.*');
      allow write: if false;
    }

    // ── Formularios públicos (cualquiera crea, solo admins leen/modifican) ────
    match /contactMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /colabMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /bugReports/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── Log de errores del cliente ────────────────────────────────────────────
    match /errors/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ── Leaderboard legacy ────────────────────────────────────────────────────
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
