rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'pinya1994@gmail.com',
        'consiguetualgogratis@gmail.com',
        'consiguetualgogratis@tuthor.app',
        'manel.willx@gmail.com'
      ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Capacidad de profesor activa sobre la propia cuenta (no es un rol
    // exclusivo: una cuenta puede seguir jugando como alumno). No basta con
    // active == true: hace falta además una suscripción de Stripe viva o
    // el código de acceso de prueba — espejo de hasTeacherAccess() en
    // src/lib/classes.js (esa duplicación es inevitable: las rules no
    // pueden importar JS del cliente).
    function isTeacher(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      let tp = u.teacherProfile;
      // isChildSession(): si el padre es profesor, su hijo comparte uid y
      // heredaría el aula entera — crear clases, asignar tareas, ver a los
      // alumnos. La capacidad es del padre, no de la cuenta.
      return request.auth != null && request.auth.uid == uid && !isChildSession()
        && 'teacherProfile' in u && tp.active == true
        && (
          ('promoCode' in tp && tp.promoCode == 'L4FXL3') ||
          ('subscriptionStatus' in tp && tp.subscriptionStatus in ['active', 'trialing'])
        );
    }

    // Profesor vinculado a este alumno (linkedTeacherIds vive en el propio
    // doc del alumno para que esto sea SIEMPRE una única lectura, sin
    // importar a cuántos profesores/clases esté vinculado).
    function isLinkedTeacher(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return request.auth != null
        && 'linkedTeacherIds' in u && request.auth.uid in u.linkedTeacherIds;
    }

    // Esta escritura activa teacherProfile.active por primera vez (no lo
    // toca si ya era true: reenviar el formulario o editar el centro/ciclo
    // no debe volver a pedir código).
    function becomesTeacher() {
      return 'teacherProfile' in request.resource.data
        && request.resource.data.teacherProfile.active == true
        && (resource == null || !('teacherProfile' in resource.data) || resource.data.teacherProfile.active != true);
    }

    // Código de acceso de profesor: de prueba y único por ahora, hardcodeado
    // aquí igual que isAdmin() hardcodea emails. Si hacen falta varios
    // códigos más adelante, esto pasa a un `in [...]` como isAdmin().
    function hasValidPromoCode() {
      return 'teacherProfile' in request.resource.data
        && request.resource.data.teacherProfile.promoCode == 'L4FXL3';
    }

    // Campos que dan acceso de pago y que por tanto SOLO puede escribir
    // Firebase Admin (api/stripe-webhook.js y scripts/backfill-legacy-free.mjs,
    // que no pasan por estas rules). Sin esto el muro es decorativo: el dueño
    // del doc se autoconcede la suscripción desde la consola del navegador con
    // un updateDoc. Espejo de accessReason() en src/lib/access.js.
    //
    // referralBonusUntil/referralCount/referredBy: el mes de Pro gratis por
    // invitar (api/apply-referral.js) es acceso igual que una suscripción —
    // mismo motivo para que solo lo toque Admin: si no, cualquiera se pone
    // referralBonusUntil en el futuro desde la consola y tiene Pro para
    // siempre gratis.
    function touchesPaidFields() {
      return resource == null
        ? request.resource.data.keys().hasAny(['subscription', 'legacyFree', 'sponsoredByTeacher', 'childCode', 'stripeCustomerId', 'referralBonusUntil', 'referralCount', 'referredBy'])
        : request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscription', 'legacyFree', 'sponsoredByTeacher', 'childCode', 'stripeCustomerId', 'referralBonusUntil', 'referralCount', 'referredBy']);
    }

    // Sesión abierta con el código del hijo (api/child-login.js mintea el token
    // con este claim). Padre e hijo comparten uid — para request.auth.uid son
    // la MISMA persona — así que este claim es lo único que los distingue.
    // Sin él, "el niño no entra en los ajustes" sería solo un botón oculto.
    function isChildSession() {
      return request.auth != null && request.auth.token.get('childMode', false) == true;
    }

    // El niño no toca el perfil de profesor: ni lo activa, ni cambia el centro,
    // ni mete un código. El resto de su doc (stats, cosméticos, progreso) sí,
    // porque es su cuenta y es lo que hace al jugar.
    function touchesTeacherProfile() {
      return resource == null
        ? 'teacherProfile' in request.resource.data
        : request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherProfile']);
    }

    // Igual, pero para teacherProfile.subscriptionStatus, que vive anidado y
    // no lo caza el diff de arriba (affectedKeys solo mira el primer nivel).
    //
    // Se bloquea el VALOR, no el campo: 'none' no concede acceso a nada, así
    // que dejarlo pasar no abre ningún agujero, y a cambio el cliente antiguo
    // —que lo escribe al dar de alta a un profesor— sigue funcionando mientras
    // el despliegue nuevo no haya llegado a todos. Lo que no puede hacer el
    // cliente es ponerse 'active' o 'trialing': eso es del webhook.
    //
    // La condición del diff deja pasar además las escrituras con merge que
    // arrastran el valor que ya puso el webhook sin modificarlo.
    function setsPrivilegedTeacherStatus() {
      return 'teacherProfile' in request.resource.data
        && request.resource.data.teacherProfile.get('subscriptionStatus', 'none') != 'none'
        && (resource == null
            || !('teacherProfile' in resource.data)
            || request.resource.data.teacherProfile.diff(resource.data.teacherProfile)
                 .affectedKeys().hasAny(['subscriptionStatus']));
    }

    // ── Perfil de usuario ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isOwner(uid) || isAdmin()
        || (request.auth != null && 'linkedTeacherIds' in resource.data && request.auth.uid in resource.data.linkedTeacherIds);
      // create/update en vez de write: en un delete `request.resource` es null
      // y touchesPaidFields() reventaría al mirar sus claves.
      allow create, update: if isOwner(uid)
        && (!becomesTeacher() || hasValidPromoCode())
        && !touchesPaidFields()
        && !setsPrivilegedTeacherStatus()
        && !(isChildSession() && touchesTeacherProfile());

      // Aquí vive legacyFree (el acceso gratis de por vida de las cuentas
      // antiguas). Nada en la app borra este doc, y si alguien lo borrase
      // perdería ese acceso sin forma de recuperarlo.
      allow delete: if false;

      match /activity/{activityId} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      match /stats/{statId} {
        allow read:  if isOwner(uid) || isAdmin() || isLinkedTeacher(uid);
        allow write: if isOwner(uid);
      }
    }

    // ── Códigos de acceso del hijo ────────────────────────────────────────────
    // childCodes/{code} → { uid } es un llavero: quien pudiera leer esta
    // colección tendría la entrada a todas las cuentas. Cerrada por completo al
    // cliente; solo la tocan api/child-login.js y api/child-code.js con Firebase
    // Admin, que no pasa por estas rules.
    //
    // Ojo con el impulso de abrir el read "solo para comprobar si un código
    // existe": eso convierte la colección en un oráculo de fuerza bruta gratis.
    match /childCodes/{code} {
      allow read, write: if false;
    }

    // ── Clases de profesor ────────────────────────────────────────────────────
    // classCodes/{code}: puente de solo-lookup "código legible → classId".
    // Lectura abierta a cualquier autenticado (no expone nada sensible: solo
    // un classId y el uid del profesor, ambos necesarios para unirse) porque
    // un alumno que aún no se ha unido no tiene permiso para leer /classes
    // directamente y necesita resolver el código primero.
    match /classCodes/{code} {
      allow read: if request.auth != null;
      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['classId', 'teacherId', 'createdAt'])
        && request.resource.data.classId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /classes/{classId} {
      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'code', 'studentIds', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.studentIds == []
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId)
        || (request.auth != null && request.auth.uid in resource.data.studentIds);

      allow update: if isAdmin()
        // Profesor: nombre, módulos activos y plano de pupitres. Nada más —
        // en particular NO studentIds: quitar a un alumno de la clase por
        // update es justo lo que no queremos que pueda pasar sin querer.
        // Las formas se comprueban aquí porque el cliente no es de fiar; el
        // contenido (qué módulos existen, qué índices son válidos) se limpia
        // al leer, en src/lib/seating.js y src/lib/teacherModules.js.
        || (request.auth != null && request.auth.uid == resource.data.teacherId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'modules', 'seating', 'updatedAt'])
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.studentIds == resource.data.studentIds
            && (!('modules' in request.resource.data) || request.resource.data.modules is map)
            && (!('seating' in request.resource.data) || (
                  request.resource.data.seating is map
                  && request.resource.data.seating.rows is int
                  && request.resource.data.seating.cols is int
                  && request.resource.data.seating.spots is map
                  && request.resource.data.seating.spots.size() <= 200))
            && request.resource.data.updatedAt == request.time)
        // Alumno uniéndose: solo puede añadir su propio uid al final de
        // studentIds, nada más (arrayUnion se resuelve antes de evaluar esto).
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'updatedAt'])
            && request.resource.data.studentIds == resource.data.studentIds.concat([request.auth.uid])
            && request.resource.data.updatedAt == request.time);

      allow delete: if false;

      // ── Asistencia: un documento por día (id = YYYY-MM-DD) ──────────────
      // Es dato de menores y del centro, así que NO lo lee ni el propio
      // alumno: solo el profesor dueño de la clase. Va en subcolección y no
      // dentro del doc de la clase porque crece un documento por día lectivo,
      // y ahí cada visita al panel se descargaría el curso entero.
      match /attendance/{day} {
        function miClase() {
          return request.auth != null
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
        }
        allow read: if isAdmin() || miClase();
        allow create, update: if miClase()
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2} (a la clase o a alumnos concretos) ────
    // studentIds es una foto fija de los destinatarios al crear la tarea.
    // completions es un mapa por alumno (completions.<uid>): el profesor puede
    // tocar cualquier campo (incluida la finalización manual de tareas de
    // texto libre); un alumno destinatario solo puede escribir SU propia
    // entrada dentro de completions (al completar un juego/examen asignado),
    // nunca el resto del documento ni la entrada de otro alumno.
    match /assignments/{taskId} {
      function classOwnedByCaller(classId) {
        return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }

      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && classOwnedByCaller(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['teacherId', 'classId', 'className', 'kind', 'gameId', 'category', 'level', 'title', 'studentIds', 'dueDate', 'createdAt', 'completions'])
        && request.resource.data.kind in ['catalog', 'text']
        && request.resource.data.studentIds is list && request.resource.data.studentIds.size() > 0
        && request.resource.data.completions == {}
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId)
        || (request.auth != null && request.auth.uid in resource.data.studentIds);

      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.createdAt == resource.data.createdAt)
        || (request.auth != null && request.auth.uid in resource.data.studentIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions'])
            && request.resource.data.completions.diff(resource.data.completions).affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if false;
    }

    // ── Contador global (solo admins leen, usuarios autenticados incrementan) ──
    match /_stats/global {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Leaderboards: una entrada por jugador ──────────────────────────────────
    // Lectura pública (rankings visibles sin sesión); cada usuario solo puede
    // escribir su propia entrada. Anti-cheat sin backend (sube el listón, no
    // lo elimina): solo los campos conocidos, score acotado y estrictamente
    // creciente, updatedAt de servidor y mínimo 15 s entre récords.
    // El cliente (updateLeaderboard en src/lib/activity.js) hace dos escrituras:
    // setDoc completo al batir récord y updateDoc solo-cosméticos al equipar.
    match /leaderboards/{game}/entries/{uid} {

      // Documento completo válido (récord nuevo, vía setDoc)
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'photoURL', 'score', 'updatedAt', 'avatarEmoji', 'bannerId', 'frameId'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 500))
          && d.score is number && d.score >= 0 && d.score <= 100000
          && d.updatedAt == request.time
          && (!('avatarEmoji' in d) || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('bannerId' in d) || (d.bannerId is string && d.bannerId.size() <= 40))
          && (!('frameId' in d) || (d.frameId is string && d.frameId.size() <= 40));
      }

      // Sync de cosméticos (updateDoc): no toca ni score ni updatedAt
      function cosmeticOnlyUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['avatarEmoji', 'bannerId', 'frameId'])
          && (!('avatarEmoji' in d) || d.avatarEmoji == null || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('bannerId' in d) || (d.bannerId is string && d.bannerId.size() <= 40))
          && (!('frameId' in d) || (d.frameId is string && d.frameId.size() <= 40));
      }

      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid) && (
        (validEntry()
          && request.resource.data.score > resource.data.score
          && (!('updatedAt' in resource.data)
            || request.time > resource.data.updatedAt + duration.value(15, 's')))
        || cosmeticOnlyUpdate()
      );
      allow delete: if false;
    }

    // ── Leaderboards legacy (_stats/leaderboard_*): solo lectura ──────────────
    // Congelados como fallback de lectura hasta que la subcolección se llene.
    match /_stats/{leaderboardId} {
      allow read: if leaderboardId.matches('leaderboard_.*');
      allow write: if false;
    }

    // ── Formularios públicos (cualquiera crea, solo admins leen/modifican) ────
    match /contactMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /colabMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /bugReports/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── Log de errores del cliente ────────────────────────────────────────────
    match /errors/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ── Leaderboard legacy ────────────────────────────────────────────────────
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
          && request.resource.data.keys().hasOnly(['marks', 'updatedAt'])
          && request.resource.data.marks is map
          && request.resource.data.marks.size() <= 200;
        allow delete: if false;
      }
    }

    // ── Tareas asignadas por el profesor (a la clase o a alumnos concretos) ────
    // studentIds es una foto fija de los destinatarios al crear la tarea.
    // completions es un mapa por alumno (completions.<uid>): el profesor puede
    // tocar cualquier campo (incluida la finalización manual de tareas de
    // texto libre); un alumno destinatario solo puede escribir SU propia
    // entrada dentro de completions (al completar un juego/examen asignado),
    // nunca el resto del documento ni la entrada de otro alumno.
    match /assignments/{taskId} {
      function classOwnedByCaller(classId) {
        return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }

      allow create: if isTeacher(request.auth.uid)
        && request.resource.data.teacherId == request.auth.uid
        && classOwnedByCaller(request.resource.data.classId)
        && request.resource.data.keys().hasOnly(['teacherId', 'classId', 'className', 'kind', 'gameId', 'category', 'level', 'title', 'studentIds', 'dueDate', 'createdAt', 'completions'])
        && request.resource.data.kind in ['catalog', 'text']
        && request.resource.data.studentIds is list && request.resource.data.studentIds.size() > 0
        && request.resource.data.completions == {}
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId)
        || (request.auth != null && request.auth.uid in resource.data.studentIds);

      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.teacherId
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.createdAt == resource.data.createdAt)
        || (request.auth != null && request.auth.uid in resource.data.studentIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions'])
            && request.resource.data.completions.diff(resource.data.completions).affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if false;
    }

    // ── Contador global (solo admins leen, usuarios autenticados incrementan) ──
    match /_stats/global {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Leaderboards: una entrada por jugador ──────────────────────────────────
    // Lectura pública (rankings visibles sin sesión); cada usuario solo puede
    // escribir su propia entrada. Anti-cheat sin backend (sube el listón, no
    // lo elimina): solo los campos conocidos, score acotado y estrictamente
    // creciente, updatedAt de servidor y mínimo 15 s entre récords.
    // El cliente (updateLeaderboard en src/lib/activity.js) hace dos escrituras:
    // setDoc completo al batir récord y updateDoc solo-cosméticos al equipar.
    match /leaderboards/{game}/entries/{uid} {

      // Documento completo válido (récord nuevo, vía setDoc)
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'photoURL', 'score', 'updatedAt', 'avatarEmoji', 'bannerId', 'frameId'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 500))
          && d.score is number && d.score >= 0 && d.score <= 100000
          && d.updatedAt == request.time
          && (!('avatarEmoji' in d) || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('bannerId' in d) || (d.bannerId is string && d.bannerId.size() <= 40))
          && (!('frameId' in d) || (d.frameId is string && d.frameId.size() <= 40));
      }

      // Sync de cosméticos (updateDoc): no toca ni score ni updatedAt
      function cosmeticOnlyUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['avatarEmoji', 'bannerId', 'frameId'])
          && (!('avatarEmoji' in d) || d.avatarEmoji == null || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('bannerId' in d) || (d.bannerId is string && d.bannerId.size() <= 40))
          && (!('frameId' in d) || (d.frameId is string && d.frameId.size() <= 40));
      }

      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid) && (
        (validEntry()
          && request.resource.data.score > resource.data.score
          && (!('updatedAt' in resource.data)
            || request.time > resource.data.updatedAt + duration.value(15, 's')))
        || cosmeticOnlyUpdate()
      );
      allow delete: if false;
    }

    // ── Leaderboards legacy (_stats/leaderboard_*): solo lectura ──────────────
    // Congelados como fallback de lectura hasta que la subcolección se llene.
    match /_stats/{leaderboardId} {
      allow read: if leaderboardId.matches('leaderboard_.*');
      allow write: if false;
    }

    // ── Formularios públicos (cualquiera crea, solo admins leen/modifican) ────
    match /contactMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /colabMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /bugReports/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── Log de errores del cliente ────────────────────────────────────────────
    match /errors/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ── Leaderboard legacy ────────────────────────────────────────────────────
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
