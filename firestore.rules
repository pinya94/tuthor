rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfil de usuario ────────────────────────────────────────────────────
    // Solo el propio usuario puede leer y escribir su perfil
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Actividades: solo el propio usuario
      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Stats: solo el propio usuario
      match /stats/{statId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Leaderboard de Tuthor Time ───────────────────────────────────────────
    // Cualquiera autenticado puede leer. Solo escribir el propio registro.
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
