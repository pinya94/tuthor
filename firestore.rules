rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfil de usuario ────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'consiguetualgogratis@gmail.com';
    }

    match /users/{uid} {
      allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;

      match /activity/{activityId} {
        allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /stats/{statId} {
        allow read:  if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Stats globales (solo contadores, sin datos personales) ───────────────
    match /_stats/{docId} {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Leaderboard de Tuthor Time ───────────────────────────────────────────
    // Cualquiera autenticado puede leer. Solo escribir el propio registro.
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
