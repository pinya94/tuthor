rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'pinya1994@gmail.com',
        'consiguetualgogratis@gmail.com',
        'consiguetualgogratis@tuthor.app',
        'manel.willx@gmail.com'
      ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Perfil de usuario ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);

      match /activity/{activityId} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      match /stats/{statId} {
        allow read:  if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // ── Contador global (solo admins leen, usuarios autenticados incrementan) ──
    match /_stats/global {
      allow read:  if isAdmin();
      allow write: if request.auth != null;
    }

    // ── Leaderboards: una entrada por jugador ──────────────────────────────────
    // Lectura pública (rankings visibles sin sesión); cada usuario solo puede
    // escribir su propia entrada, con score numérico acotado.
    match /leaderboards/{game}/entries/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000;
    }

    // ── Leaderboards legacy (_stats/leaderboard_*): solo lectura ──────────────
    // Congelados como fallback de lectura hasta que la subcolección se llene.
    match /_stats/{leaderboardId} {
      allow read: if leaderboardId.matches('leaderboard_.*');
      allow write: if false;
    }

    // ── Formularios públicos (cualquiera crea, solo admins leen/modifican) ────
    match /contactMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /colabMessages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /bugReports/{docId} {
      allow create: if request.resource.data.keys().hasAll(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── Log de errores del cliente ────────────────────────────────────────────
    match /errors/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ── Leaderboard legacy ────────────────────────────────────────────────────
    match /leaderboard/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
